# Generate a random local worker token of at least 32 characters. Never use VITE_ for secrets.
WEBGUIDE_WORKER_TOKEN=replace-with-a-random-value-at-least-32-characters
# Local/self-hosted AI. No cloud key required for this mode.
WEBGUIDE_AI_PROVIDER=ollama
WEBGUIDE_AI_BASE_URL=http://127.0.0.1:11436
WEBGUIDE_AI_MODEL=qwen3:4b
WEBGUIDE_AI_API_KEY=
WEBGUIDE_MANAGED_OLLAMA=1
WEBGUIDE_JOB_TIMEOUT_MS=180000
# Only enable for the separately hosted controlled synthetic fixture.
WEBGUIDE_SANDBOX_ORIGIN=http://127.0.0.1:4319
WEBGUIDE_RETENTION_MS=3600000

# SQLite evidence is stored here. Keep this directory private and exclude it from shared ZIPs.
WEBGUIDE_DATA_DIR=.webguide-local/data
