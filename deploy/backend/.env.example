# Copy to deploy/backend/.env locally, never commit the filled file.
# Generate a random 32-byte token; frontend users enter it only in session memory.
WEBGUIDE_WORKER_TOKEN=replace-with-a-unique-random-64-character-value
# Exact Host values reaching the backend, including local healthcheck host.
WEBGUIDE_ALLOWED_HOSTS=api.example.com,127.0.0.1:8080,127.0.0.1:4318
WEBGUIDE_ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:4320
WEBGUIDE_AI_PROVIDER=openai-compatible
WEBGUIDE_AI_BASE_URL=https://model.example.com/v1
WEBGUIDE_AI_MODEL=your-served-model-alias
WEBGUIDE_AI_API_KEY=replace-locally-with-model-service-key
WEBGUIDE_RETENTION_MS=3600000
WEBGUIDE_JOB_TIMEOUT_MS=180000
# Do not set WEBGUIDE_SANDBOX_ORIGIN in hosted real-site deployments.
